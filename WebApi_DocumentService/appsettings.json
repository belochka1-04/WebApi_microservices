{
  "ConnectionStrings": {
    // основная БД Kamera (то, что ты читаешь как "KameraDb")
    "KameraDb": "Server=DESKTOP-POLEQKO\\MSSQLSERVER16;Database=ApplianceDb_v1;Trusted_Connection=True;Encrypt=True;TrustServerCertificate=True;",

    // если где‑то ещё используются (можно оставить пустыми или удалить)
    "DefaultConnection": "",
    "KameraDb2": "Server=DESKTOP-1AK7DCC;Database=ApplianceDb_v1;User Id=webapi;Password=$7MlZc6Y8ryJSsGqO7mEwWBh2;"
  },

  // тип БД, если SharedMicroserviceLibrary его использует
  "DatabaseType": "MSSQL",

  // ASP.NET Core logging (для внутреннего пайплайна; фактически всё перехватывает Serilog)
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },

  // Kestrel / URL сервиса
  // можно задать через этот ключ, чтобы сервис слушал определённый порт
  "Urls": "http://0.0.0.0:7050",

  // Serilog для микросервиса
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          // путь относительно папки с .exe; для Windows-сервиса логично
          "path": "logs/webapi-logs.txt",
          "rollingInterval": "Day",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },

  // JWT для SharedAuthentication
  "Authentication": {
    "SecretKey": "super-secret-key-change-me",
    "Issuer": "WebApi_services",
    "Audience": "WebApi-client"
  },

  
  // Настройки Prometheus при необходимости (порт забирается из Urls; эндпоинт /metrics уже в коде)
  "Prometheus": {
    "Enabled": true,
    "MetricsPath": "/metrics"
  },

  // ASP.NET Core infrastructure
  "AllowedHosts": "*"
}
