{
  "ConnectionStrings": {
    "DefaultConnection": "",
    "KameraDb": "Server=DESKTOP-POLEQKO\\MSSQLSERVER16;Database=ApplianceDb_v1;Trusted_Connection=True;Encrypt=True;TrustServerCertificate=True;",
    "KameraDb2": ""
  },
  "DatabaseType": "MSSQL",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://0.0.0.0:7049",

  // Настройки Prometheus при необходимости (порт забирается из Urls; эндпоинт /metrics уже в коде)
  "Prometheus": {
    "Enabled": true,
    "MetricsPath": "/metrics"
  },

  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "theme": "Serilog.Sinks.SystemConsole.Themes.AnsiConsoleTheme::Code, Serilog.Sinks.Console",
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/UserService-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext} {Message:lj} {Properties:j}{NewLine}{Exception}",
          "fileSizeLimitBytes": 10485760,
          "rollOnFileSizeLimit": true
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },

  "Jwt": {
    "SecretKey": "YourSuperSecretKeyMinimum32CharactersLong!@#$%",
    "Issuer": "KameraUserService",
    "Audience": "KameraClients",
    "ExpirationMinutes": 60,
    "RequireHttpsMetadata": false,
    "ValidateIssuer": false,
    "ValidateAudience": false
  }
}